# ============================================================
#  Finance Roast App — Environment Variables
#  Copy this to .env and fill in your real values.
#  NEVER commit .env to git.
# ============================================================

# --- PostgreSQL ---
POSTGRES_USER=finance
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=finance_db

# --- SimpleFIN Bridge ---
# Option A: Paste your setup token here on first boot.
#   The /api/setup/claim-simplefin endpoint will exchange it for the access URL.
SIMPLEFIN_SETUP_TOKEN=
# Option B: Paste the already-claimed access URL directly (includes credentials).
#   Format: https://user:pass@bridge.simplefin.org/simplefin
SIMPLEFIN_ACCESS_URL=

# --- LLM (Gemini via OpenAI-compatible endpoint) ---
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=YOUR_GEMINI_API_KEY
LLM_MODEL=gemini-2.0-flash

# --- Telegram Bot (Primary notification channel) ---
TELEGRAM_BOT_TOKEN=YOUR_BOT_TOKEN_FROM_BOTFATHER
TELEGRAM_CHAT_ID=YOUR_PERSONAL_CHAT_ID

# --- Carrier Email-to-SMS (Optional fallback) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your_app_password
SMS_GATEWAY_EMAIL=10digitnumber@vtext.com

# --- Nvidia Shield TV ---
SHIELD_TV_IP=192.168.1.XXX
SHIELD_LIVE_TOAST_ENABLED=false

# --- App Behavior ---
SYNC_INTERVAL_HOURS=4
DEBT_ALERT_THRESHOLD=1500.0
SAFE_TO_SPEND_ALERT_THRESHOLD=500.0
TIMEZONE=America/Los_Angeles

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://10.10.10.4:8001

# --- Roast Blacklist (comma-separated merchant substrings) ---
ROAST_BLACKLIST=DOORDASH,UBER EATS,DRAFTKINGS,STEAM
